{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Довод",
  "mainBinaryName": "dovod",
  "version": "0.0.1",
  "identifier": "law.dovod.desktop",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["bootstrap", "web-shell-external-url"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Довод — рабочее место юриста",
    "longDescription": "Довод: настольный ассистент для российских юристов. Modified for DOVOD; based on Qwen Code (Apache License 2.0).",
    "publisher": "DOVOD",
    "copyright": "Copyright 2026 DOVOD. Includes Qwen Code, Copyright 2026 Qwen Team, Apache License 2.0.",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../runtime/qwen-code": "runtime/qwen-code"
    },
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {}
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERPVk9EIFBMQUNFSE9MREVSIChubyB1cGRhdGVzIGFyZSBzaWduZWQgd2l0aCB0aGlzIGtleSkKUldTQVpNK0lKQ3dmRnhXVlRNd2EyNWtIcHNUUXdna3VJbTlUV1lIcWVEZ2xueGRaUFF0a0ZiM3QK",
      "endpoints": ["https://updates.dovod.law/desktop/latest.json"]
    }
  }
}
