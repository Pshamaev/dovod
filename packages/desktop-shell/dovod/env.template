# Довод — подключение к языковой модели и к инструментам.
# Этот файл создаётся при первом запуске (если его ещё не было) и никогда
# не перезаписывается. Заполните значения и перезапустите Довод.
#
# Адрес OpenAI-совместимого API (например https://api.example.com/v1)
DOVOD_API_BASE=
# Ключ доступа к API
DOVOD_API_KEY=
# Имя модели, которое ожидает этот API (имя модели в приложение не зашито)
DOVOD_MODEL=
# Папка dovod-tools из репозитория garant-bot на этом компьютере
# (например C:\Users\User\Documents\garant-bot\dovod-tools). Подставляется
# в команды /dovod:* и в сервер проверки ссылок при первом запуске.
DOVOD_TOOLS=
