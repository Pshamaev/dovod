# Довод - подключение к языковой модели.
# Этот файл создаётся при первом запуске (если его ещё не было) и никогда
# не перезаписывается. Заполните значения и перезапустите Довод.
#
# Адрес OpenAI-совместимого API (например https://api.example.com/v1)
DOVOD_API_BASE=
# Ключ доступа к API
DOVOD_API_KEY=
# Имя модели, которое ожидает этот API (имя модели в приложение не зашито)
DOVOD_MODEL=
# Необязательно: адрес сервера доступа Довода (полный адрес ручки, например
# https://api.dovod.law/v1/access). Если заполнен и три строки выше - пустые,
# при входе в переписку вместо них откроется экран «Введите код доступа» -
# введённый там код обменивается на эти три значения через эту ручку, и они
# не сохраняются на диск. Если сервера ещё нет, оставьте пустым: тогда
# работает только путь выше - заполнить DOVOD_API_BASE/KEY/MODEL вручную.
DOVOD_ACCESS_SERVER=
