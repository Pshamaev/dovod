# Довод — подключение к языковой модели.
# Этот файл создаётся при первом запуске (если его ещё не было) и никогда
# не перезаписывается. Заполните три значения и перезапустите Довод.
#
# Адрес OpenAI-совместимого API (например https://api.example.com/v1)
DOVOD_API_BASE=
# Ключ доступа к API
DOVOD_API_KEY=
# Имя модели, которое ожидает этот API (имя модели в приложение не зашито)
DOVOD_MODEL=
