{
  "$version": 4,
  "general": {
    "language": "ru-RU"
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "${DOVOD_MODEL}"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "${DOVOD_MODEL}",
        "name": "Довод (${DOVOD_MODEL})",
        "description": "Модель Довода. Адрес, ключ и имя модели задаются в ~/.qwen/.env (DOVOD_API_BASE, DOVOD_API_KEY, DOVOD_MODEL).",
        "envKey": "DOVOD_API_KEY",
        "baseUrl": "${DOVOD_API_BASE}"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python __DOVOD_TOOLS__\\dovod_prompts.py)",
      "Bash(python3 __DOVOD_TOOLS__\\dovod_prompts.py)"
    ]
  },
  "mcpServers": {}
}
