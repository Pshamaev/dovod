{
  "$version": 4,
  "general": {
    "language": "ru-RU"
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "model": {
    "name": "${DOVOD_MODEL}"
  },
  "modelProviders": {
    "openai": [
      {
        "id": "${DOVOD_MODEL}",
        "name": "Довод (${DOVOD_MODEL})",
        "description": "Модель Довода. Адрес, ключ и имя модели задаются в ~/.qwen/.env (DOVOD_API_BASE, DOVOD_API_KEY, DOVOD_MODEL).",
        "envKey": "DOVOD_API_KEY",
        "baseUrl": "${DOVOD_API_BASE}"
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(\"__DOVOD_TOOLS__\\dovod_prompts.exe\")"]
  },
  "tools": {
    "disabled": [
      "run_shell_command",
      "edit",
      "write_file",
      "read_file",
      "glob",
      "grep_search",
      "list_directory",
      "notebook_edit",
      "web_fetch",
      "web_search",
      "agent",
      "skill",
      "workflow",
      "lsp",
      "enter_worktree",
      "exit_worktree",
      "cron_create",
      "cron_list",
      "cron_delete",
      "send_message",
      "create_sub_session",
      "monitor",
      "image_gen",
      "save_memory"
    ]
  },
  "mcpServers": {}
}
